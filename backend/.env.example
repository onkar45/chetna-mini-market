# Database Configuration
# For Neon PostgreSQL: postgresql://username:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require
# For Local Docker PostgreSQL: postgresql://postgres:postgres@localhost:5432/retail_rate_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_rate_db

# Security & JWT Configuration
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (used by seed_admin.py)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# App Environment & CORS
ENVIRONMENT=development
ALLOWED_ORIGINS=*

# Cloudinary Cloud Object Storage (Persistent product photos)
# Sign up at https://cloudinary.com/ and obtain credentials from your Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=chetna_products
